NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Only supported by next dev on localhost. Production build/start reject true.
NEXT_PUBLIC_LOCAL_DEMO=false
# Firebase web configuration is public project metadata, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
