# V2 only; the legacy app has its own configuration.
# Local demo additionally requires a loopback database whose name ends in _demo.
APP_ENV=production
LOCAL_DEMO=false
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://raseed:raseed_local@localhost:5432/raseed
# Must be a separate disposable database, never the application database.
TEST_DATABASE_URL=postgresql+psycopg://raseed:raseed_local@localhost:5432/raseed_test
FIREBASE_PROJECT_ID=your-firebase-project-id
CORS_ORIGINS=["http://localhost:3000"]
# Private receipt storage. GCS requires ADC and a private bucket; local needs neither.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local/receipts
GCS_BUCKET=
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
# Configure a Gemini model available to your project. No AI call occurs during upload.
GEMINI_MODEL=
GEMINI_API_KEY=
EXTRACTION_TIMEOUT_SECONDS=45
RECEIPT_LEASE_SECONDS=300
RECEIPT_MAX_ATTEMPTS=3
RECEIPT_RETRY_SECONDS=5
WORKER_POLL_SECONDS=2
# Optional assistant provider. No network request occurs at startup; tests inject fakes.
ASSISTANT_MODEL=
OPENAI_API_KEY=
ASSISTANT_REQUEST_TIMEOUT_SECONDS=20
ASSISTANT_TURN_TIMEOUT_SECONDS=120
ASSISTANT_MAX_ROUNDS=6
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_ATTEMPTS=2
ASSISTANT_MAX_OUTPUT_TOKENS=4096
# Optional Google Wallet. ADC authorizes REST; IAM Credentials signs save JWTs.
WALLET_ISSUER_ID=
WALLET_SERVICE_ACCOUNT_EMAIL=
WALLET_ORIGINS=["http://localhost:3000"]
WALLET_REQUEST_TIMEOUT_SECONDS=15
# Optional eBay Browse provider; use an application OAuth token authorized for Browse.
MARKET_EBAY_TOKEN=
MARKET_EBAY_MARKETPLACE=EBAY_US
MARKET_REQUEST_TIMEOUT_SECONDS=10
# Set ADC in your shell or use a credential file OUTSIDE this repository:
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
